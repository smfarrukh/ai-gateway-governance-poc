# AI Gateway Governance POC - settings
# Copy this file to config/poc.env and fill in the values as you go through the walkthrough.
# config/poc.env holds secrets: never commit it or email it.

# ---------------- Google Cloud / Apigee ----------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
# The Apigee organization name is the project id.
APIGEE_ENV=eval
# Hostname of the Apigee environment group, e.g. https://34-120-10-10.nip.io  (step 4)
APIGEE_HOST=
# Service account the gateway proxies run as (step 4)
APIGEE_PROXY_SA=ai-gateway-proxy@your-gcp-project-id.iam.gserviceaccount.com
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE=ai-gateway-guard
GEMINI_MODEL=gemini-2.5-flash

# Private Cloud Run URLs of the mock systems (step 3)
SERVICENOW_URL=
SALESFORCE_URL=
KNOWLEDGE_BASE_URL=

# ---------------- Microsoft Azure ----------------
# e.g. https://my-aoai-resource.openai.azure.com/openai/v1
AZURE_OPENAI_BASE_URL=
# Deployment name of the model (keep it identical to the model name, e.g. gpt-5-mini)
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_KEY=

# ---------------- Amazon Web Services ----------------
AWS_REGION=us-east-1
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_MODEL=openai.gpt-oss-120b
BEDROCK_API_KEY=

# ---------------- Agent keys (written by: python tools/poc.py setup-agents) ----------------
ITSM_AGENT_GCP_KEY=
SALES_AGENT_AWS_KEY=
CX_AGENT_AZURE_KEY=
