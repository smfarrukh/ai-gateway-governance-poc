<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="vertex-gemini">
  <Description>Gemini on Vertex AI (OpenAI-compatible endpoint), authenticated with the proxy service account</Description>
  <DefaultFaultRule name="audit-on-error">
    <AlwaysEnforce>true</AlwaysEnforce>
    <Step>
      <Name>JS-BuildAudit</Name>
    </Step>
  </DefaultFaultRule>
  <PreFlow name="PreFlow">
    <Request>
        <Step>
          <Name>JS-PrepareBackendRequest</Name>
        </Step>
        <Step>
          <Name>AM-StripAgentCredentials</Name>
        </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPTargetConnection>
    <Authentication>
      <GoogleAccessToken>
        <Scopes>
          <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
        </Scopes>
      </GoogleAccessToken>
    </Authentication>
    <URL>https://aiplatform.googleapis.com/v1/projects/{{GCP_PROJECT_ID}}/locations/global/endpoints/openapi</URL>
  </HTTPTargetConnection>
</TargetEndpoint>
