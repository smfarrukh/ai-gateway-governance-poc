<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="aws-bedrock">
  <Description>Amazon Bedrock (Mantle OpenAI-compatible endpoint); API key injected from the encrypted KVM</Description>
  <DefaultFaultRule name="audit-on-error">
    <AlwaysEnforce>true</AlwaysEnforce>
    <Step>
      <Name>JS-BuildAudit</Name>
    </Step>
  </DefaultFaultRule>
  <PreFlow name="PreFlow">
    <Request>
        <Step>
          <Name>JS-PrepareBackendRequest</Name>
        </Step>
        <Step>
          <Name>AM-StripAgentCredentials</Name>
        </Step>
        <Step>
          <Name>KVM-GetBackendSecrets</Name>
        </Step>
        <Step>
          <Name>AM-SetBedrockKey</Name>
        </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPTargetConnection>
    <URL>{{BEDROCK_BASE_URL}}</URL>
  </HTTPTargetConnection>
</TargetEndpoint>
