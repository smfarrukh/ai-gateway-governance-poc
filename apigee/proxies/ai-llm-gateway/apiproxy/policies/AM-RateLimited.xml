<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-RateLimited">
  <DisplayName>AM-RateLimited</DisplayName>
  <AssignVariable>
    <Name>gw.decision</Name>
    <Value>denied:rate_limited</Value>
  </AssignVariable>
  <Set>
    <Payload contentType="application/json" variablePrefix="@" variableSuffix="#">{"error":{"type":"policy_violation","code":"rate_limited","message":"Agent request rate limit exceeded. Slow down and retry."}}</Payload>
    <StatusCode>429</StatusCode>
    <ReasonPhrase>Too Many Requests</ReasonPhrase>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
