<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<KeyValueMapOperations continueOnError="false" enabled="true" name="KVM-GetBackendSecrets" mapIdentifier="ai-gateway-secrets">
  <DisplayName>KVM-GetBackendSecrets</DisplayName>
  <!-- Azure and AWS model keys live only in Apigee's encrypted key value map, never in agents. -->
  <Scope>environment</Scope>
  <ExpiryTimeInSecs>300</ExpiryTimeInSecs>
  <Get assignTo="private.azure_openai_key">
    <Key>
      <Parameter>azure_openai_key</Parameter>
    </Key>
  </Get>
  <Get assignTo="private.bedrock_api_key">
    <Key>
      <Parameter>bedrock_api_key</Parameter>
    </Key>
  </Get>
</KeyValueMapOperations>
