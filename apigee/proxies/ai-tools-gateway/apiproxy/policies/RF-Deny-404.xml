<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-Deny-404">
  <DisplayName>RF-Deny-404</DisplayName>
  <FaultResponse>
    <Set>
      <Headers>
        <Header name="x-ai-gateway-decision">{gw.decision}</Header>
      </Headers>
      <Payload contentType="application/json">{gw.deny_body}</Payload>
      <StatusCode>404</StatusCode>
      <ReasonPhrase>Not Found</ReasonPhrase>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
