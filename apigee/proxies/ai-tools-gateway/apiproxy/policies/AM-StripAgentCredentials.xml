<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-StripAgentCredentials">
  <DisplayName>AM-StripAgentCredentials</DisplayName>
  <!-- The agent's gateway key never leaves the gateway. -->
  <Remove>
    <Headers>
      <Header name="x-api-key"/>
      <Header name="Authorization"/>
    </Headers>
  </Remove>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
