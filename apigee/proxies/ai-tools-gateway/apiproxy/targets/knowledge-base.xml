<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="knowledge-base">
  <Description>Mock knowledge base REST API on Cloud Run (private, called with a Google ID token)</Description>
  <DefaultFaultRule name="audit-on-error">
    <AlwaysEnforce>true</AlwaysEnforce>
    <Step>
      <Name>JS-BuildAudit</Name>
    </Step>
  </DefaultFaultRule>
  <PreFlow name="PreFlow">
    <Request>
        <Step>
          <Name>AM-StripAgentCredentials</Name>
        </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPTargetConnection>
    <Authentication>
      <GoogleIDToken>
        <Audience>{{KNOWLEDGE_BASE_URL}}</Audience>
      </GoogleIDToken>
    </Authentication>
    <URL>{{KNOWLEDGE_BASE_URL}}</URL>
  </HTTPTargetConnection>
</TargetEndpoint>
