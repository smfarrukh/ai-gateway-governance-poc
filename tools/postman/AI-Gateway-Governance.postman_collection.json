{
  "info": {
    "name": "AI Gateway Governance POC",
    "description": "Seventeen checks that prove the governance controls of the multi-cloud AI gateway POC. Select the environment 'AI Gateway POC' first, then use Run collection to execute them in order. Checks 16 and 17 need a policy change in the Apigee console first (see their descriptions).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 No agent key is refused",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"401 Unauthorized\", () => pm.response.to.have.status(401));",
              "const decision = pm.response.headers.get(\"x-ai-gateway-decision\") || \"(none)\";",
              "console.log(\"gateway decision:\", decision);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{gatewayHost}}/ai/llm/v1/chat/completions",
          "host": [
            "{{gatewayHost}}"
          ],
          "path": [
            "ai",
            "llm",
            "v1",
            "chat",
            "completions"
          ]
        },
        "description": "An unregistered caller has no identity at the gateway, so it cannot reach any model.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"{{geminiModel}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"hello\"\n    }\n  ],\n  \"max_tokens\": 200\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 GCP agent to Gemini (approved)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"routed to Vertex AI\", () => pm.expect(pm.response.headers.get(\"x-ai-gateway-backend\")).to.eql(\"vertex\"));",
              "console.log(\"tokens:\", pm.response.headers.get(\"x-ai-gateway-tokens\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{itsmKey}}"
          }
        ],
        "url": {
          "raw": "{{gatewayHost}}/ai/llm/v1/chat/completions",
          "host": [
            "{{gatewayHost}}"
          ],
          "path": [
            "ai",
            "llm",
            "v1",
            "chat",
            "completions"
          ]
        },
        "description": "The IT Service Desk agent may use Gemini. The gateway routes to Vertex AI and adds the credential.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"{{geminiModel}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"In one sentence, what is an AI gateway?\"\n    }\n  ],\n  \"max_tokens\": 200\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
