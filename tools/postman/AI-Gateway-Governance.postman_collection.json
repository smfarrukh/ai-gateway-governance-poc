    {
      "name": "16 Token budget exhausted (after lowering it in the console)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"429 Too Many Requests\", () => pm.response.to.have.status(429));",
              "pm.test(\"token budget\", () => pm.expect(pm.response.json().error.code).to.eql(\"token_quota_exceeded\"));",
              "console.log(\"Remember to set the budget back to 30000 in the console.\");"
            ]
          }
        }
