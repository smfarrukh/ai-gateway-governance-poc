    {
      "name": "08 Azure agent only sees its approved tools",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const names = pm.response.json().result.tools.map(x => x.name);",
              "console.log(\"visible tools:\", names.join(\", \"));",
              "pm.test(\"read tools visible\", () => pm.expect(names).to.include(\"sn_get_incident\"));",
              "pm.test(\"write tools hidden\", () => pm.expect(names).to.not.include(\"sn_close_incident\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{cxKey}}"
          },
          {
            "key": "Accept",
            "value": "application/json, text/event-stream"
          }
        ],
        "url": {
          "raw": "{{gatewayHost}}/ai/tools/mcp/servicenow",
          "host": [
            "{{gatewayHost}}"
          ],
          "path": [
            "ai",
            "tools",
            "mcp",
            "servicenow"
          ]
        },
        "description": "tools/list is filtered by the gateway, so unapproved tools are invisible to the agent.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/list\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 Azure agent is denied a high-risk tool",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json().result;",
              "console.log(r.content[0].text);",
              "pm.test(\"tool call refused\", () => pm.expect(r.isError).to.be.true);",
              "pm.test(\"gateway explains the refusal\", () => pm.expect(r.content[0].text).to.include(\"ACCESS DENIED\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{cxKey}}"
          },
          {
            "key": "Accept",
            "value": "application/json, text/event-stream"
          }
        ],
        "url": {
          "raw": "{{gatewayHost}}/ai/tools/mcp/servicenow",
          "host": [
            "{{gatewayHost}}"
          ],
          "path": [
            "ai",
            "tools",
            "mcp",
            "servicenow"
          ]
        },
        "description": "Even if the agent asks directly, closing an incident is refused, with a message the agent can explain.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"sn_close_incident\",\n    \"arguments\": {\n      \"number\": \"INC0010002\",\n      \"resolution_notes\": \"test\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
