    {
      "name": "12 Personal data is masked for the Azure agent",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const text = pm.response.json().result.content[0].text;",
              "pm.test(\"email masked\", () => pm.expect(text).to.include(\"***@acme.example\"));",
              "pm.test(\"phone masked\", () => pm.expect(text).to.include(\"REDACTED-PHONE\"));",
              "pm.test(\"raw email absent\", () => pm.expect(text).to.not.include(\"sarah.mitchell@acme.example\"));",
              "pm.test(\"business data intact\", () => pm.expect(text).to.include(\"1250000\"));"
            ]
          }
        }
